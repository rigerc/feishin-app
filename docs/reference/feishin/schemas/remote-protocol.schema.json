      "required": [
        "id",
        "_uniqueId"
      ],
      "additionalProperties": true,
      "description": "Partial schema: the upstream QueueSong is Song & {_uniqueId, optional _contextPlaylistId}; the full Song has many more required fields. Other properties are allowed."
