    },
    "Client25": {
      "type": "object",
      "properties": {
        "event": {
          "const": "playlists-request"
        },
        "requestId": {
          "type": "string"
        },
        "limit": {
          "type": "integer",
          "minimum": 0
        },
        "searchTerm": {
          "type": "string"
        },
        "startIndex": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "event",
