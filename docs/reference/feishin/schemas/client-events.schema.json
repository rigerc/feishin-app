    },
    {
      "$ref": "#/$defs/Client18"
    },
    {
      "$ref": "#/$defs/Client19"
    },
    {
      "$ref": "#/$defs/Client20"
    },
    {
      "$ref": "#/$defs/Client21"
    },
    {
      "$ref": "#/$defs/Client22"
    },
    {
      "$ref": "#/$defs/Client23"
    },
    {
      "$ref": "#/$defs/Client24"
    },
    {
      "$ref": "#/$defs/Client25"
    },
    {
      "$ref": "#/$defs/Client26"
    }
  ],
  "$defs": {
    "Play": {
      "type": "string",
      "enum": [
        "index",
        "last",
        "lastShuffle",
        "next",
        "nextShuffle",
        "now",
        "shuffle"
      ]
    },
    "PlayerRepeat": {
      "type": "string",
      "enum": [
        "all",
        "none",
        "one"
      ]
    },
    "PlayerStatus": {
      "type": "string",
      "enum": [
        "paused",
        "playing",
        "stopped"
      ]
    },
    "QueueSong": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "_uniqueId": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "_uniqueId"
      ],
      "additionalProperties": true,
      "description": "Partial schema: the upstream QueueSong is Song & {_uniqueId, optional _contextPlaylistId}; the full Song has many more required fields. Other properties are allowed."
    },
    "SongState": {
      "type": "object",
      "properties": {
        "position": {
          "type": "number"
        },
        "repeat": {
          "$ref": "#/$defs/PlayerRepeat"
        },
        "shuffle": {
          "type": "boolean"
        },
        "song": {
          "$ref": "#/$defs/QueueSong"
        },
        "status": {
          "$ref": "#/$defs/PlayerStatus"
        },
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      },
      "additionalProperties": false,
      "description": "All fields are optional in the upstream SongState type."
    },
    "RemoteTrackItem": {
      "type": "object",
      "properties": {
        "album": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "artistName": {
          "type": "string"
        },
        "duration": {
          "type": "number"
        },
        "id": {
          "type": "string"
        },
        "imageUrl": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "album",
        "artistName",
        "duration",
        "id",
        "imageUrl",
        "name"
      ],
      "additionalProperties": false
    },
    "RemoteAlbumItem": {
      "type": "object",
      "properties": {
        "albumArtistName": {
          "type": "string"
        },
        "duration": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "type": "string"
        },
        "imageUrl": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string"
        },
        "releaseYear": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "songCount": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "albumArtistName",
        "duration",
        "id",
        "imageUrl",
        "name",
        "releaseYear",
        "songCount"
      ],
      "additionalProperties": false
    },
    "RemotePlaylistItem": {
      "type": "object",
      "properties": {
        "duration": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "type": "string"
        },
        "imageUrl": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string"
        },
        "songCount": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "duration",
        "id",
        "imageUrl",
        "name",
        "songCount"
      ],
      "additionalProperties": false
    },
    "RemoteQueueItem": {
      "type": "object",
      "properties": {
        "album": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "artistName": {
          "type": "string"
        },
        "duration": {
          "type": "number"
        },
        "id": {
          "type": "string"
        },
        "imageUrl": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string"
        },
        "uniqueId": {
          "type": "string"
        }
      },
      "required": [
        "album",
        "artistName",
        "duration",
        "id",
        "imageUrl",
        "name",
        "uniqueId"
      ],
      "additionalProperties": false
    },
    "RemoteRadioItem": {
      "type": "object",
      "properties": {
        "homepageUrl": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "type": "string"
        },
        "imageUrl": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "homepageUrl",
        "id",
        "imageUrl",
        "name"
      ],
      "additionalProperties": false
    },
    "RemoteListResponse": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string"
        },
        "hasMore": {
          "type": "boolean"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "required": [
        "requestId",
        "hasMore",
        "items"
      ],
      "additionalProperties": false
    },
    "Client01": {
      "type": "object",
      "properties": {
        "event": {
          "const": "authenticate"
        },
        "header": {
          "type": "string",
          "description": "Basic <base64(username:password)>; supplied as a JSON WebSocket message"
        }
      },
      "required": [
        "event",
        "header"
      ],
      "additionalProperties": false
    },
    "Client02": {
      "type": "object",
      "properties": {
        "event": {
          "const": "play"
        }
      },
      "required": [
        "event"
      ],
      "additionalProperties": false
    },
    "Client03": {
      "type": "object",
      "properties": {
        "event": {
          "const": "pause"
        }
      },
      "required": [
        "event"
      ],
      "additionalProperties": false
    },
    "Client04": {
      "type": "object",
      "properties": {
        "event": {
          "const": "next"
        }
      },
      "required": [
        "event"
      ],
      "additionalProperties": false
    },
    "Client05": {
      "type": "object",
      "properties": {
        "event": {
          "const": "previous"
        }
      },
