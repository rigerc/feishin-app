        }
      },
      "required": [
        "event"
      ],
      "additionalProperties": false
    },
    "Client09": {
      "type": "object",
      "properties": {
        "event": {
          "const": "volume"
        },
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Feishin clamps received values to 0–100."
        }
      },
      "required": [
        "event",
        "volume"
      ],
      "additionalProperties": false
    },
    "Client10": {
      "type": "object",
      "properties": {
        "event": {
          "const": "position"
        },
        "position": {
          "type": "number",
          "description": "Playback seek position in seconds."
        }
      },
      "required": [
        "event",
        "position"
      ],
      "additionalProperties": false
    },
    "Client11": {
      "type": "object",
      "properties": {
        "event": {
          "const": "favorite"
        },
        "id": {
          "type": "string"
        },
        "favorite": {
          "type": "boolean"
        }
      },
      "required": [
        "event",
        "id",
        "favorite"
      ],
      "additionalProperties": false
    },
    "Client12": {
      "type": "object",
      "properties": {
        "event": {
          "const": "rating"
        },
        "id": {
          "type": "string"
        },
        "rating": {
          "type": "number"
        }
      },
      "required": [
        "event",
        "id",
        "rating"
      ],
      "additionalProperties": false
    },
    "Client13": {
      "type": "object",
      "properties": {
        "event": {
          "const": "play-radio"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "event",
        "id"
      ],
      "additionalProperties": false
    },
    "Client14": {
      "type": "object",
      "properties": {
        "event": {
          "const": "play-track"
        },
        "id": {
          "type": "string"
        },
        "playType": {
          "$ref": "#/$defs/Play"
        },
        "requestId": {
          "type": "string"
        }
      },
      "required": [
        "event",
        "id"
      ],
      "additionalProperties": false
    },
    "Client15": {
      "type": "object",
      "properties": {
        "event": {
          "const": "play-album"
        },
        "id": {
          "type": "string"
        },
        "playType": {
          "$ref": "#/$defs/Play"
        },
        "requestId": {
          "type": "string"
        }
      },
      "required": [
        "event",
        "id"
      ],
      "additionalProperties": false
    },
    "Client16": {
      "type": "object",
      "properties": {
        "event": {
          "const": "play-playlist"
        },
        "id": {
          "type": "string"
        },
        "playType": {
          "$ref": "#/$defs/Play"
        },
        "requestId": {
          "type": "string"
        }
      },
      "required": [
        "event",
        "id"
      ],
      "additionalProperties": false
    },
    "Client17": {
      "type": "object",
      "properties": {
        "event": {
          "const": "play-track-radio"
        },
        "id": {
          "type": "string"
        },
        "playType": {
          "$ref": "#/$defs/Play"
        },
