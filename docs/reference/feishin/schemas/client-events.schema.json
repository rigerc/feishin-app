      "properties": {
        "event": {
          "const": "radio-request"
        },
        "requestId": {
          "type": "string"
        },
        "limit": {
          "type": "integer",
          "minimum": 0
        },
        "searchTerm": {
          "type": "string"
        },
        "startIndex": {
          "type": "integer",
          "minimum": 0
