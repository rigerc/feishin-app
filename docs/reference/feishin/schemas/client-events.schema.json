          "type": "string"
        }
      },
      "required": [
        "event",
        "id",
        "playType"
      ],
      "additionalProperties": false
    },
    "Client18": {
      "type": "object",
      "properties": {
        "event": {
          "const": "clear-queue"
        },
        "requestId": {
          "type": "string"
        }
      },
      "required": [
        "event"
      ],
      "additionalProperties": false
    },
    "Client19": {
      "type": "object",
      "properties": {
        "event": {
          "const": "add-to-playlist"
        },
        "playlistId": {
          "type": "string"
        },
        "songId": {
          "type": "string"
        },
        "requestId": {
          "type": "string"
        }
      },
      "required": [
        "event",
        "playlistId",
        "songId"
      ],
      "additionalProperties": false
    },
    "Client20": {
      "type": "object",
      "properties": {
        "event": {
          "const": "queue-jump"
        },
        "uniqueId": {
          "type": "string"
        }
      },
      "required": [
        "event",
        "uniqueId"
      ],
      "additionalProperties": false
    },
    "Client21": {
      "type": "object",
      "properties": {
        "event": {
          "const": "remove-from-queue"
        },
        "uniqueId": {
          "type": "string"
        }
      },
      "required": [
        "event",
        "uniqueId"
      ],
      "additionalProperties": false
    },
    "Client22": {
      "type": "object",
      "properties": {
        "event": {
          "const": "reorder-queue"
        },
        "edge": {
          "enum": [
            "bottom",
            "top"
          ]
        },
        "targetUniqueId": {
          "type": "string"
        },
        "uniqueId": {
          "type": "string"
        }
      },
      "required": [
        "event",
        "edge",
        "targetUniqueId",
        "uniqueId"
      ],
      "additionalProperties": false
    },
    "Client23": {
      "type": "object",
      "properties": {
        "event": {
          "const": "tracks-request"
        },
        "requestId": {
          "type": "string"
        },
        "limit": {
          "type": "integer",
          "minimum": 0
        },
        "searchTerm": {
          "type": "string"
        },
        "startIndex": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "event",
        "requestId"
      ],
      "additionalProperties": false
    },
    "Client24": {
      "type": "object",
      "properties": {
        "event": {
          "const": "albums-request"
        },
        "requestId": {
          "type": "string"
        },
        "limit": {
          "type": "integer",
          "minimum": 0
        },
        "searchTerm": {
          "type": "string"
        },
        "startIndex": {
