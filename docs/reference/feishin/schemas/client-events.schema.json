{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/feishin-remote/client-events.schema.json",
  "title": "Feishin Remote API — client messages",
  "description": "Unofficial JSON Schema derived from the Feishin development-branch TypeScript definitions; verify against the installed version. QueueSong/SongState nested Song payloads are only partially constrained.",
  "oneOf": [
    {
      "$ref": "#/$defs/Client01"
    },
    {
      "$ref": "#/$defs/Client02"
    },
    {
      "$ref": "#/$defs/Client03"
    },
    {
      "$ref": "#/$defs/Client04"
    },
    {
      "$ref": "#/$defs/Client05"
    },
    {
      "$ref": "#/$defs/Client06"
    },
    {
      "$ref": "#/$defs/Client07"
    },
    {
      "$ref": "#/$defs/Client08"
    },
    {
      "$ref": "#/$defs/Client09"
    },
    {
      "$ref": "#/$defs/Client10"
    },
    {
      "$ref": "#/$defs/Client11"
    },
    {
      "$ref": "#/$defs/Client12"
    },
    {
      "$ref": "#/$defs/Client13"
    },
    {
      "$ref": "#/$defs/Client14"
    },
    {
      "$ref": "#/$defs/Client15"
    },
    {
      "$ref": "#/$defs/Client16"
    },
    {
